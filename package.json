{
  "name": "runegrove",
  "displayName": "Codehaven \u2014 Fantasy Coding Village",
  "description": "A painterly fantasy coding village, guild workshop, editor themes, and parchment file icons for Cursor.",
  "version": "0.5.0",
  "publisher": "runegrove",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "cursor",
    "fantasy",
    "woodland",
    "parchment",
    "theme"
  ],
  "main": "./src/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onCommand:runegrove.openVillage",
    "onCommand:runegrove.openWorkshop"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "runegrove.openVillage",
        "title": "Codehaven: Open Village Map",
        "icon": "$(home)"
      },
      {
        "command": "runegrove.openWorkshop",
        "title": "Codehaven: Open Guild Workshop",
        "icon": "$(book)"
      }
    ],
    "themes": [
      {
        "label": "Codehaven Nightfall",
        "uiTheme": "vs-dark",
        "path": "./themes/nightfall.json"
      },
      {
        "label": "Codehaven Parchment",
        "uiTheme": "vs",
        "path": "./themes/parchment.json"
      }
    ],
    "iconThemes": [
      {
        "id": "runegrove-icons",
        "label": "Codehaven File Icons",
        "path": "./icons/file-icons.json"
      }
    ],
    "configuration": {
      "title": "Codehaven",
      "properties": {
        "runegrove.reduceMotion": {
          "type": "boolean",
          "default": false,
          "description": "Disable village transitions, in addition to your operating system preference."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "runegrove.workshop",
        "displayName": "Codehaven Guild Workshop",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "test": "node test/extension.test.js",
    "check": "node --check src/extension.js && node --check media/village.js && node --check src/workshop.js",
    "package": "npm run build && python3 scripts/package.py",
    "build": "esbuild src/webview/workshop.js --bundle --minify --format=iife --outfile=media/workshop-editor.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
